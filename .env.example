# WellDrill Ethiopia — Environment Variables
# ⚠️  NEVER commit this file to GitHub — add to .gitignore

# ── Server ──────────────────────────────────────────
PORT=5000
NODE_ENV=development
APP_NAME=WellDrill Ethiopia
FRONTEND_URL=http://localhost:3000

# ── Supabase / PostgreSQL ────────────────────────────
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

# ── Firebase Admin ───────────────────────────────────
FIREBASE_PROJECT_ID=welldrill-ethiopia
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@welldrill-ethiopia.iam.gserviceaccount.com

# ── OpenAI ───────────────────────────────────────────
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_KEY

# ── Chapa Payments (Ethiopian) ────────────────────────
CHAPA_SECRET_KEY=CHASECK_TEST-YOUR_KEY
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# ── Agora.io (WebRTC Voice Calls) ────────────────────
AGORA_APP_ID=YOUR_AGORA_APP_ID
AGORA_APP_CERTIFICATE=YOUR_AGORA_CERTIFICATE

# ── Redis (Upstash — free tier) ──────────────────────
REDIS_URL=rediss://default:YOUR_TOKEN@YOUR_ENDPOINT.upstash.io:6379

# ── JWT ──────────────────────────────────────────────
JWT_SECRET=welldrill_super_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# ── Commission ───────────────────────────────────────
PLATFORM_COMMISSION_PERCENT=5
